# 값은 .env.local 과 Vercel 환경 변수에만 넣는다. 이 파일에는 이름만 적는다.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 열쇠(Supabase 설정 화면의 service_role). 브라우저에 나가면 안 되므로 NEXT_PUBLIC_ 을 붙이지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 봇 방지: 접속 주소를 해시할 때 섞는 임의의 긴 글자(없으면 위 서버 전용 열쇠를 대신 쓴다)
RATE_LIMIT_SALT=

# 메일 보내기(아키텍터의 기존 네이버 메일 계정). 도메인을 사면 이 값만 바꾸면 된다.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=

# 아클링스 앞으로 온 새 협업 신청 알림을 받을 메일 주소
ADMIN_NOTIFY_EMAIL=

# 정기 정리 작업(3개월 지난 협업 신청 삭제 등)을 부를 때 확인하는 비밀값. 임의의 긴 글자를 정해 Vercel에 넣으면 Vercel 예약 작업이 이 값을 자동으로 실어 보낸다.
CRON_SECRET=

# 미션7-2 AI 기능(서버에서만 읽는다. NEXT_PUBLIC_ 을 붙이지 않는다). 값은 .env.local 과 Vercel 환경 변수에만 넣는다.
# OpenAI 키와 모델 이름. 둘 다 있어야 진짜 모델을 쓸 수 있다.
OPENAI_API_KEY=
OPENAI_MODEL=
# 가짜 모델 스위치: 1 이면 OpenAI를 부르지 않고 정해진 샘플 답으로 연결·오류·형식 경로만 시험한다(비용 0). 비어 있으면 꺼짐.
AI_FAKE_MODEL=
